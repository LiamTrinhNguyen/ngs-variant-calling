// =============================================================================
// Settings for the Nextflow pipeline (workflow/main.nf)
// =============================================================================
// Samples, reference and filters come from config/config.yaml (the same file
// Snakemake uses). Anything set here or on the command line wins, e.g.
//   nextflow run workflow/main.nf --outdir /tmp/run --min_dp 20
// =============================================================================

params {
    config         = "${projectDir}/../config/config.yaml"   // samples + filters
    // WHY a different default folder from Snakemake's `results`: the two engines
    //     track finished work differently, so they shouldn't share an output folder
    outdir         = 'results_nf'
    threads        = 4        // CPUs per fastp / bwa mem / samtools sort job
    // Left empty → read from config.yaml
    reference      = null
    min_qual       = null
    min_dp         = null
    min_af         = null
    hotspot_window = null
    // Sample checks – empty/null → read from config.yaml (host_index, kraken_db, screen, kraken_memory_mapping)
    host_index     = null     // bwa index of the host genome → host removal on
    kraken_db      = null     // Kraken2 database folder → classification on
    screen         = null     // false → skip the reference screen
    kraken_memory_mapping = null
}

// Task work folders go inside the output folder instead of ./work where you launch.
// workflow/run_nextflow.sh also moves .nextflow.log and the .nextflow/ cache there.
workDir = "${params.outdir}/nextflow/work"

process {
    // WHY 1 by default: only fastp, bwa mem/samtools sort and the sample checks use threads, and
    //     Nextflow refuses a task that asks for more CPUs than the machine has
    //     ("Task requirement exceeds available CPUs"), e.g. 4 on a 2-core Codespace.
    cpus = 1
    // WHY retry the downloads: ENA/NCBI sometimes drop connections. Each attempt
    //     already resumes up to 5 times inside download_file(); this re-runs the task.
    withName: 'DOWNLOAD_READS|DOWNLOAD_REFERENCE' {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withName: 'FASTP|ALIGN|HOST_REMOVAL|SCREEN|CLASSIFY' {
        // capped at this machine's cores; on a cluster, set cpus = params.threads instead
        cpus = Math.min(params.threads as int, Runtime.runtime.availableProcessors())
    }
    // WHY local: runs on this machine. For a cluster, change to 'slurm' (and add
    //     queue = '…'); for the cloud, 'awsbatch' or 'google-batch'.
    executor = 'local'
}

// Nextflow's own run reports: what ran, how long, CPU and memory per step.
// WHY: shows where time goes and helps size jobs on a cluster.
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_info/trace.tsv" }
